# Copy to .env and fill in for Phase 4 (real testnet execution) -- not
# needed for Phase 0-3, which run with zero credentials.
#
# Never put mainnet credentials here. DERIVE_ETH_CHAIN should stay SEPOLIA
# (testnet) for the lifetime of this project's paper-trading phase.
DERIVE_WALLET=
DERIVE_SESSION_KEY=
DERIVE_SUBACCOUNT_ID=
DERIVE_ETH_CHAIN=SEPOLIA
DERIVE_ETH_RPC_ENDPOINTS=
EXECUTION_ENABLED=false
